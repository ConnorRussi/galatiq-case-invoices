XAI_API_KEY=
# Optional: defaults to grok-3-mini.
XAI_MODEL=grok-3-mini
# Optional: override for a compatible local or proxy endpoint.
XAI_API_ENDPOINT=https://api.x.ai/v1
# TAMUS is selected with `python main.py -tamu ...`.
TAMUS_AI_CHAT_API_KEY=
TAMUS_AI_CHAT_MODEL=
TAMUS_AI_CHAT_API_ENDPOINT=https://chat-api.tamu.ai
# Optional inventory database path; --database-path takes precedence.
INVENTORY_DATABASE_PATH=
# Optional tracing:
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=invoice-ingestion
